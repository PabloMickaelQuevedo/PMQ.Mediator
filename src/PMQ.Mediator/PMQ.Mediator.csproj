<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PMQ.Mediator</RootNamespace>
    <PackageId>PMQ.Mediator</PackageId>
    <Version>1.1.2</Version>
    <Product>PMQ.Mediator</Product>
    <Description>
      A lightweight mediator pattern implementation for .NET applications with FluentValidation integration, request/response pipeline behaviors, streaming support, and notification publishing.
    </Description>
    <PackageProjectUrl>https://github.com/PabloMickaelQuevedo/PMQ.Mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PabloMickaelQuevedo/PMQ.Mediator.git</RepositoryUrl>
    <PackageTags>mediator;cqrs;pipeline;fluentvalidation;requests;notifications;streaming</PackageTags>
    <IncludeLicenseFile>true</IncludeLicenseFile>
  </PropertyGroup>

  <!--
    Compara a API deste build com a do pacote já publicado, baixado do NuGet, e por
    target framework. Remover membro público reprova o pack com CP0002.

    O baseline é a última versão publicada e sobe junto com o release. Quebra
    intencional se registra com -p:ApiCompatGenerateSuppressionFile=true, commitando
    o arquivo gerado — a decisão fica explícita e revisável em vez de silenciosa.

    Compara assinatura, não piso de dependência: subir o grupo net8.0 para um pacote
    10.x continua sendo trabalho do guard em Directory.Build.targets.
  -->
  <PropertyGroup Label="Compatibilidade">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.1.2</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
